[Unit]
Description=StarkTrade Celery Worker
After=network.target redis-server.service postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/starktrade-ai/backend
EnvironmentFile=/root/starktrade-ai/backend/.env
ExecStart=/root/starktrade-ai/backend/venv/bin/celery -A app.services.celery_app worker --loglevel=info --concurrency=2
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
