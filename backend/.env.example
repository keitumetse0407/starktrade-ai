# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://starktrade:starktrade@localhost:5432/starktrade

# ─── Security ───────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-key
ENVIRONMENT=development
DEBUG=True

# ─── CORS / Allowed Hosts ───────────────────────────────────
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── AI / LLM ───────────────────────────────────────────────
# Get from https://console.groq.com/keys
GROQ_API_KEY=

# ─── Trading Engine ─────────────────────────────────────────
TRADING_ENGINE_WS_URL=ws://localhost:8081/ws
TRADING_ENGINE_URL=http://localhost:8081

# ─── Payments ───────────────────────────────────────────────
# PayFast sandbox = true, production = false
PAYFAST_SANDBOX=true

# ─── Alpaca Trading ─────────────────────────────────────────
# Paper trading keys from https://app.alpaca.markets/paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2
